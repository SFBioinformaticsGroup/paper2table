{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline",
  "description": "Declarative pipeline for paper2table tools.",
  "type": "object",
  "additionalProperties": false,
  "required": ["working_path"],
  "properties": {
    "working_path": {
      "type": "string",
      "description": "Base directory for the pipeline. Input PDFs must be in ${working_path}/papers/. schema.txt, column_hints.txt, column_aliases.txt, and paper_aliases.txt are auto-read from ${working_path} when they exist and are non-empty."
    },
    "pretty": {
      "type": "boolean",
      "default": false,
      "description": "Indent JSON output from all tools that support --pretty."
    },
    "normalize": {
      "anyOf": [{ "$ref": "#/$defs/NormalizeConfig" }, { "type": "null" }],
      "default": null
    },
    "extract": {
      "anyOf": [{ "$ref": "#/$defs/ExtractConfig" }, { "type": "null" }],
      "default": null
    },
    "merge": {
      "anyOf": [{ "$ref": "#/$defs/MergeConfig" }, { "type": "null" }],
      "default": null
    },
    "gather": {
      "anyOf": [{ "$ref": "#/$defs/GatherConfig" }, { "type": "null" }],
      "default": null
    },
    "readme": {
      "anyOf": [{ "$ref": "#/$defs/ReadmeConfig" }, { "type": "null" }],
      "default": null,
      "description": "When present, generate README.md in ${working_path}. Omit to skip README generation entirely."
    }
  },
  "$defs": {
    "ReadmeConfig": {
      "title": "ReadmeConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "override": {
          "type": "boolean",
          "default": false,
          "description": "When true, overwrite README.md even if it already exists."
        }
      }
    },
    "NormalizeConfig": {
      "title": "NormalizeConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interactive": {
          "type": "boolean",
          "default": true,
          "description": "true = prompt for each change; false = auto-confirm silently (-y -q)."
        }
      }
    },
    "ExtractRun": {
      "title": "ExtractRun",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reader": {
          "type": "string",
          "default": "pdfplumber",
          "enum": ["pdfplumber", "camelot", "agent", "hybrid", "pymupdf", "img2table"],
          "description": "Extraction backend."
        },
        "model": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Language model (-m)."
        },
        "model_sleep": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null,
          "description": "Seconds between model calls (-z)."
        },
        "verbose": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging (-vv)."
        },
        "hybrid": {
          "type": "boolean",
          "default": false,
          "description": "Enable hybrid mode (-H)."
        },
        "override_mappings": {
          "type": "boolean",
          "default": false,
          "description": "Regenerate mapping even if cached (--override-mappings / -F). This is not influenced by override; override only wipes tables/, never mappings/."
        },
        "schema": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Inline schema string (-s); overrides ${working_path}/schema.txt for this run."
        },
        "column_hints": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Inline column name hints; overrides column_hints_path and ${working_path}/column_hints.txt for this run."
        },
        "column_hints_path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Explicit path to column name hints file (-c); if omitted, ${working_path}/column_hints.txt is used when present and non-empty. Overridden by column_hints."
        },
        "split_pages": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "default": null,
          "description": "Max pages per agent call (--split-pages)."
        },
        "quiet": {
          "type": "boolean",
          "default": false,
          "description": "Suppress progress output (-q)."
        },
        "id": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Resultset directory name (--id). Defaults to a UUID v4 when omitted. If the directory already exists, the run is skipped."
        }
      }
    },
    "ExtractConfig": {
      "title": "ExtractConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExtractRun" },
          "description": "One or more paper2table extraction passes."
        },
        "page_ranges": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            { "type": "null" }
          ],
          "default": null,
          "description": "Optional page ranges per paper. Keys are paper basenames (filename without .pdf); values are 'FROM:TO' (1-indexed, inclusive). Papers not listed are extracted in full."
        },
        "stats": {
          "type": "boolean",
          "default": false,
          "description": "Run tablestats after each run and write output to ${id}/stats.txt."
        },
        "validate": {
          "type": "boolean",
          "default": false,
          "description": "Run tablevalidate on each run's output."
        },
        "export": {
          "type": "array",
          "items": { "type": "string", "enum": ["csv", "html"] },
          "default": [],
          "description": "Export formats to produce after each run."
        },
        "override": {
          "type": "boolean",
          "default": false,
          "description": "Wipe ${working_path}/tables/ before running. When false, a warning is printed if the directory already has contents."
        }
      }
    },
    "MergeConfig": {
      "title": "MergeConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreement_method": {
          "type": "string",
          "default": "simple-count",
          "enum": ["simple-count", "distinct-readers"]
        },
        "filter_title_rows": { "type": "boolean", "default": true },
        "remove_header_rows": { "type": "boolean", "default": false },
        "jaccard_column_alignment": { "type": "boolean", "default": false },
        "column_alignment_threshold": { "type": "number", "default": 0.5 },
        "row_similarity_threshold": {
          "type": "number",
          "default": 0.6,
          "description": "Minimum Levenshtein similarity ratio for two rows to be considered equal during merging (default: 0.6)."
        },
        "column_name_semantic_alignment": { "type": "boolean", "default": false },
        "column_value_semantic_alignment": { "type": "boolean", "default": false },
        "semantic_language": {
          "type": "string",
          "default": "en",
          "enum": ["en", "es"]
        },
        "column_aliases": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null
        },
        "column_aliases_path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Explicit path to alias map file; if omitted, ${working_path}/column_aliases.txt is used when present and non-empty. Overridden by column_aliases."
        },
        "column_hints": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null
        },
        "column_hints_path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Explicit path to hints file; if omitted, ${working_path}/column_hints.txt is used when present and non-empty. Overridden by column_hints."
        },
        "hints_column_alignment": {
          "anyOf": [
            { "type": "string", "enum": ["safe", "unsafe"] },
            { "type": "null" }
          ],
          "default": null
        },
        "paper_aliases": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null
        },
        "paper_aliases_path": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "default": null,
          "description": "Explicit path to paper alias map file; if omitted, ${working_path}/paper_aliases.txt is used when present and non-empty. Overridden by paper_aliases."
        },
        "fix_reversed_column_values": { "type": "boolean", "default": false },
        "strip_leading_row_numbers": { "type": "boolean", "default": false },
        "normalize_punctuation": { "type": "boolean", "default": false },
        "split_conjunction_columns": { "type": "boolean", "default": false },
        "transform_tablesfile": {
          "anyOf": [
            { "type": "string", "enum": ["explode", "safe-compact", "unsafe-compact"] },
            { "type": "null" }
          ],
          "default": null
        },
        "filter_schema_columns": { "type": "boolean", "default": false },
        "order_schema_columns": { "type": "boolean", "default": false },
        "coerce_schema_column_types": { "type": "boolean", "default": false },
        "filter_semantic_columns": { "type": "boolean", "default": false },
        "drop_empty_columns": { "type": "boolean", "default": true },
        "drop_empty_tables": { "type": "boolean", "default": true },
        "validate": {
          "type": "boolean",
          "default": false,
          "description": "Run tablevalidate on the merged output."
        },
        "stats": {
          "type": "boolean",
          "default": false,
          "description": "Run tablestats and write output to merges/stats.txt."
        },
        "export": {
          "type": "array",
          "items": { "type": "string", "enum": ["csv", "html"] },
          "default": []
        },
        "override": {
          "type": "boolean",
          "default": false,
          "description": "Wipe ${working_path}/merges/ before running. When false, a warning is printed if the directory already has contents. Deletes all files including curated ones — use force_update instead to preserve files not in the current run."
        },
        "force_update": {
          "type": "boolean",
          "default": false,
          "description": "Pass --force-update to tablemerge: overwrite output files that contain curations. Only affects files produced by the current run; files from previous runs not in the current inputs are left untouched. Ignored when override is true (the directory is wiped before tablemerge runs)."
        }
      }
    },
    "GatherConfig": {
      "title": "GatherConfig",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "convergence": {
          "type": "string",
          "default": "none",
          "enum": ["none", "rows", "fragments", "tables"]
        },
        "convergence_level": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "key_columns": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ],
          "default": null,
          "description": "Column names to sort gathered rows by."
        },
        "filter_schema_columns": { "type": "boolean", "default": false },
        "order_schema_columns": { "type": "boolean", "default": false },
        "coerce_schema_column_types": { "type": "boolean", "default": false },
        "filter_semantic_columns": { "type": "boolean", "default": false },
        "drop_empty_columns": { "type": "boolean", "default": true },
        "drop_empty_tables": { "type": "boolean", "default": true },
        "stats": {
          "type": "boolean",
          "default": false,
          "description": "Run tablestats and write output to gathers/stats.txt."
        },
        "export": {
          "type": "array",
          "items": { "type": "string", "enum": ["csv", "html"] },
          "default": []
        },
        "override": {
          "type": "boolean",
          "default": false,
          "description": "Wipe ${working_path}/gathers/ before running. When false, a warning is printed if the directory already has contents."
        }
      }
    }
  }
}
