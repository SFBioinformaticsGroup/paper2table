{
  "working_path": "tests/data/pipeline",
  "pretty": true,
  "normalize": {
    "interactive": true
  },
  "extract": {
    "runs": [
      {
        "id": "pymupdf-hybrid",
        "reader": "pymupdf",
        "model": "google-gla:gemini-2.5-flash",
        "hybrid": true
      },
      {
        "id": "gemini",
        "reader": "agent",
        "model": "google-gla:gemini-2.5-flash",
        "model_sleep": 10
      }
    ],
    "stats": true,
    "validate": true,
    "override": false,
    "export": [
      "csv",
      "html"
    ]
  },
  "merge": {
    "agreement_method": "distinct-readers",
    "filter_title_rows": true,
    "fix_reversed_column_values": true,
    "jaccard_column_alignment": true,
    "normalize_punctuation": true,
    "filter_semantic_columns": false,
    "semantic_language": "es",
    "split_conjunction_columns": false,
    "strip_leading_row_numbers": true,
    "transform_tablesfile": "unsafe-compact",
    "validate": true,
    "stats": true,
    "export": [
      "csv",
      "html"
    ],
    "override": true
  },
  "gather": {
    "stats": true,
    "export": [
      "csv",
      "html"
    ],
    "override": true
  }
}
