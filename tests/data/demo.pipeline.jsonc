{
  // base directory: papers at ${working_path}/papers/, schema at ${working_path}/schema.txt
  "working_path": ".",
  "normalize": {
    // filenorm -y -q
    "interactive": false
  },
  "extract": {
    // pipeline can execute paper2table 1 or more times with different args
    // output of each run is ${working_path}/tables/${uuid}
    "runs": [
      {
        // args for paper2table
        "reader": "agent",
        "model": "google-gla:gemini-2.5-flash",
        "model_sleep": 10
      }
    ],
    // if present and true, run tablestats after run and redirect it to ${working_path}/tables/${uuid}/stats.txt
    "stats": true,
    // if present and true, run tablevalidate after run
    "validate": true,
    // if present, will run table2csv, table2html as needed after run
    "export": ["csv", "html"]
  },
  // if present and non empty, previous paper2table runs with -t
  "merge": {
    "agreement_method": "distinct-readers",
    "jaccard_column_alignment": true,
    "semantic_language": "es",
    // if present and true, run tablestats after run and redirect it to ${working_path}/merges/stats.txt
    "stats": true,
    // if present, will run table2csv, table2html as needed after run
    "export": ["html"]
    // when this pipeline is used, --settings / --export-settings are never ignored
  },
  "gather": {
    "convergence": "rows",
    "key_columns": ["species", "family"],
    // ...
    // output is ${working_path}/gathers
    // if present and true, run tablestats after run and redirect it to ${working_path}/gathers/stats.txt
    "stats": true,
    // if present, will run table2csv, table2html as needed after run
    "export": ["csv"]
  }
}
